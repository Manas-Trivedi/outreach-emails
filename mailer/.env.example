# Copy to .env and fill in. .env is gitignored and must never be committed.
# Only needed for actually sending; the dry-run works without it.

# The address mail is sent from.
SMTP_USER=you@gmail.com

# For Gmail: an App Password (16 chars), NOT your account password.
# myaccount.google.com -> Security -> 2-Step Verification -> App passwords
SMTP_PASS=

# Optional. These are the defaults; leave them unless you use another host.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465